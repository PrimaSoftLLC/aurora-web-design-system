{
  "$schema": "../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "ui-kit": {
      "projectType": "library",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "tsconfig.spec.json",
            "browsers": "ChromeHeadless",
            "reporters": ["progress"]
          }
        }
      }
    }
  }
}
