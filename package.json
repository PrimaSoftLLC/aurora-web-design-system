{
  "name": "@nikolaynn/design-system",
  "version": "2.0.0",
  "description": "Aurora — дизайн-система веб-интерфейса GPS-мониторинга: токены, компоненты, линтер",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikolayNN/aurora-web-design-system.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "components/src/index.js",
  "files": [
    "dist/",
    "fonts/",
    "assets/fonts/",
    "components/src/",
    "lint/",
    "!lint/test/",
    "templates/angular/",
    "tokens.json",
    "CHANGELOG.md",
    "MIGRATION.md",
    "ANGULAR.md",
    "LINT.md"
  ],
  "exports": {
    ".": "./components/src/index.js",
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./tokens.json",
    "./stylelint-config": "./lint/config.js",
    "./echarts-theme": "./components/src/components/charts/echartsTheme.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "npm run test:lint && npm run test:ui",
    "test:lint": "node lint/test/run.js",
    "test:ui": "node tests/DsFilterMenu.test.js && node tests/a11y-tokens.test.js && node tests/rows-buttons.test.js && node tests/nav-dialog-i18n.test.js && node tests/guard-bash.test.js && node tests/package.test.js",
    "check:names": "node lint/scripts/check-names.js",
    "check:delivery": "node lint/scripts/check-delivery.js",
    "build:allowlist": "node lint/scripts/build-allowlist.js",
    "build:scoped-tokens": "node lint/scripts/build-scoped-tokens.js",
    "build": "node tools/build.js",
    "check:parity": "node tools/check-parity.js",
    "check:pack": "node tools/check-pack.js",
    "prepack": "npm run build",
    "verify": "npm test && npm run build && node tests/build.test.js && node tests/dist-cascade.test.js && npm run check:pack"
  },
  "peerDependencies": {
    "@angular/common": ">=19.0.0",
    "@angular/core": ">=19.0.0",
    "echarts": "^5.5.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/common": {
      "optional": true
    }
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "stylelint": "^16.10.0"
  },
  "engines": {
    "node": ">=20"
  }
}
