{
  "name": "@aurora/design-system",
  "version": "1.1.0",
  "description": "Aurora — дизайн-система веб-интерфейса GPS-мониторинга: токены, компоненты, линтер",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "components/src/index.js",
  "exports": {
    ".": "./components/src/index.js",
    "./styles.css": "./components/bundle.css",
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./stylelint-config": "./lint/config.js",
    "./echarts-theme": "./components/src/components/charts/echartsTheme.mjs"
  },
  "scripts": {
    "test": "npm run test:lint && npm run test:ui",
    "test:lint": "node lint/test/run.js",
    "test:ui": "node tests/DsFilterMenu.test.js && node tests/a11y-tokens.test.js && node tests/rows-buttons.test.js && node tests/nav-dialog-i18n.test.js && node tests/guard-bash.test.js",
    "check:names": "node lint/scripts/check-names.js",
    "check:delivery": "node lint/scripts/check-delivery.js",
    "build:allowlist": "node lint/scripts/build-allowlist.js",
    "build:scoped-tokens": "node lint/scripts/build-scoped-tokens.js"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "stylelint": "^16.10.0"
  },
  "engines": {
    "node": ">=20"
  }
}
