    {
      "name": "DsNeutrals",
      "group": "2 · Основы",
      "summary": "Одна холодная рампа с ровным шагом — вместо шести несвязанных легаси-серых",
      "page": true
    },
    {
      "name": "DsShape",
      "group": "2 · Основы",
      "summary": "Настоящая шкала радиусов; иерархию держат границы, тень только поднимает",
      "page": true
    },
    {
      "name": "DsSorting",
      "group": "2 · Основы",
      "summary": "Порядок задаёт заголовок столбца: три состояния, цикл из двух, серверный ключ — и какие столбцы сортируемы",
      "page": true
    },
    {
      "name": "DsSortingMenu",
      "group": "2 · Основы",
      "summary": "Меню сортировки для поверхностей без заголовков: поле и направление раздельно, дефолт есть всегда",
      "page": true
    },
    {
      "name": "DsStatus",
      "group": "2 · Основы",
      "summary": "Не зависит от темы — одинакова в DEFAULT, в RED2 и в dark — заливка, чернила, линия и solid",
      "page": true
    },
    {
      "name": "DsType",
      "group": "2 · Основы",
      "summary": "Один кегль на задачу; трекинг и моно заданы токеном, плотность на кегль не влияет",
      "page": true
    },
    {
      "name": "IconsArrows",
      "group": "4 · Бренд (общее)",
      "summary": "Стрелки направления так, как их рисует трек — треугольник в цвете трека с белой кромкой 1 px. Десять цветовых вариантов.",
      "page": true
    },
    {
      "name": "IconsMapAssets",
      "group": "4 · Бренд (общее)",
      "summary": "Настоящие SVG-файлы — единственная нешрифтовая иконография. Два вида: глифы, тонируемые внутри белого диска, и готовые пины.",
      "page": true
    },
    {
      "name": "MapTrack",
      "group": "4 · Бренд (общее)",
      "summary": "Линия + треугольники направления + пины начала/финиша. Число стрелок следует масштабу карты — потяните зум.",
      "page": true
    },
    {
      "name": "Monitoring",
      "group": "6 · Эталонные экраны",
      "summary": "user-portal: панель объектов, рейка карты, карточка объекта. Тема / dark / плотность — в полосе сверху",
      "page": true
    }
  ],
